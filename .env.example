# =============================================================================
# CTRL — Root environment EXAMPLE (copy to .env and fill in)
# =============================================================================

# ---- Brand ------------------------------------------------------------------
# Authoritative brand lives in the DB `settings` table; these are fallback only.
VITE_BRAND_NAME=CTRL
VITE_BRAND_MOTTO=Stay in CTRL.

# ---- Theme colors (dark) ----------------------------------------------------
VITE_THEME_BG=#000000
VITE_THEME_SURFACE=#0B0B0B
VITE_THEME_ELEVATED=#141414
VITE_THEME_BORDER=#232323
VITE_THEME_TEXT=#FFFFFF
VITE_THEME_MUTED=#9A9A9A
VITE_THEME_ACCENT=#8EFF19

# ---- Frontend -> Backend ----------------------------------------------------
VITE_API_BASE_URL=http://localhost:2830

# ---- Backend server ---------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=2830
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Auth / JWT -------------------------------------------------------------
# Embedded in the backend (backend/app/core/security.py) — nothing to set here.

# ---- Database (AES-256 encrypted values) ------------------------------------
# Generate each with:  python -m app.core.crypto encrypt "value"
DB_HOST_ENC=
DB_PORT_ENC=
DB_USER_ENC=
DB_PASSWORD_ENC=
DB_NAME_ENC=

# ---- Seed superadmin --------------------------------------------------------
# Defined in database/db.sql (bcrypt-hashed), not here.
